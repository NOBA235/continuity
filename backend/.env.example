# Copy to .env and fill in real values. Never commit the filled-in file.
# Every one of these is read by app/config.py (Settings) -- there is no
# code path that falls back to a mock value if one of these is missing;
# the app raises a pydantic ValidationError at startup instead.

# --- ClickHouse -------------------------------------------------------
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=continuity_agent
CLICKHOUSE_SECURE=true

# --- Gemini / google-genai ----------------------------------------------
# Get a key at https://aistudio.google.com/apikey (or use Vertex AI service
# account auth instead -- see google-genai's docs for GOOGLE_GENAI_USE_VERTEXAI).
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_AGENT_MODEL=gemini-3-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# --- Video / ingestion --------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
KEYFRAME_INTERVAL_SECONDS=1.0
UPLOAD_DIR=/tmp/continuity-agent/uploads
FRAME_CACHE_DIR=/tmp/continuity-agent/frames
MAX_UPLOAD_SIZE_MB=4096

# --- MCP bridge -----------------------------------------------------------
# MCP_CLICKHOUSE_COMMAND / MCP_CLICKHOUSE_ARGS are deliberately NOT set
# here. Their code-level defaults (app/config.py) already do the right
# thing for local dev: `uv run --with mcp-clickhouse mcp-clickhouse`,
# fetched into an ephemeral env on first launch (needs `uv` on PATH).
# The Dockerfile bakes a different value in via its own ENV instructions
# for the same variables -- if this file set them too, docker-compose's
# env_file loading would override the image's baked-in path with the
# local-dev default, and `uv` isn't installed in that image. Only set
# these yourself if you need a third, custom launch method.
MCP_CLICKHOUSE_ALLOW_WRITE=false

# --- Auth (JWT) -----------------------------------------------------------
# Generate with: openssl rand -hex 32
# Rotating this immediately invalidates every outstanding access/refresh token.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Object storage ---------------------------------------------------------
# "local" writes uploaded dailies to UPLOAD_DIR on this backend's own disk --
# fine for local dev or a single long-lived instance, not for horizontal
# scaling or most serverless platforms' ephemeral filesystems. Set to "gcs"
# for anything beyond that; requires GCS_BUCKET_NAME and standard GCP
# credentials (GOOGLE_APPLICATION_CREDENTIALS, or workload identity on
# Cloud Run/GKE -- never a key this app handles directly).
STORAGE_BACKEND=local
GCS_BUCKET_NAME=
GCS_SIGNED_URL_EXPIRATION_MINUTES=60

# --- Observability ------------------------------------------------------
LOG_LEVEL=INFO
# "console" is easier to read locally; "json" is what you want piped into
# Cloud Logging / any log aggregator.
LOG_FORMAT=json
OTEL_SERVICE_NAME=continuity-agent-api
# If unset, traces print to stdout via ConsoleSpanExporter instead of an
# OTLP collector -- fine for local dev, not for production.
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# --- API ------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
API_ROOT_PATH=


# 